# MEMORA Frontend Environment
# Copy to frontend/.env and fill in. VITE_* values are bundled into the browser build.

# Backend base URL (dev default uses Vite proxy "/api" -> http://localhost:8000)
VITE_API_URL=/api

# Supabase (optional but recommended for hosted auth sessions)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
