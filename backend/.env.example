# MEMORA Backend Environment Configuration
# Copy to backend/.env and fill in (NEVER commit real keys).

# Supabase project (Dashboard -> Settings -> API)
SUPABASE_URL=
# Publishable / anon key (safe for backend user-scoped ops; frontend uses VITE_SUPABASE_ANON_KEY)
SUPABASE_KEY=
SUPABASE_ANON_KEY=
# Service-role key (BACKEND ONLY - full bypass of RLS, keep server-side)
SUPABASE_SERVICE_ROLE_KEY=
# Optional: Supabase legacy JWT secret (only if you add offline FastAPI JWT verification)
SUPABASE_JWT_SECRET=

# CORS: comma-separated frontend origins (dev default "*")
CORS_ORIGINS=http://localhost:3000

# Sarvam AI (Indian regional voice STT & TTS, https://dashboard.sarvam.ai)
SARVAM_API_KEY=
SARVAM_STT_URL=https://api.sarvam.ai/speech-to-text
SARVAM_TTS_URL=https://api.sarvam.ai/text-to-speech

# App secret for local demo JWTs + PIN hashing (set a long random value in prod)
SECRET_KEY=change_me_to_a_long_random_secret

# Environment: development / staging / production
ENVIRONMENT=development
